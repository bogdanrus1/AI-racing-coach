
# ==========================================
# AI Racing Coach - Git Ignore
# ==========================================

# ------------------------------------------
# Environment variables and secrets
# ------------------------------------------
.env
.env.*
!.env.example
!.env.template
*.pem
*.key
*.p12
*.pfx
*.cer
*.crt
secrets.json
secrets.*.json
appsettings.Local.json

# ------------------------------------------
# .NET / ASP.NET Core
# ------------------------------------------
**/bin/
**/obj/
**/out/
**/TestResults/
*.user
*.suo
*.cache
*.coverage
*.coveragexml
project.lock.json
.nuget/
artifacts/

# Keep standard application configuration files
# appsettings.json and appsettings.Development.json
# are NOT ignored by default.

# ------------------------------------------
# Node.js / npm
# ------------------------------------------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
.npm/
.pnpm-store/

# ------------------------------------------
# Svelte / SvelteKit
# ------------------------------------------
.svelte-kit/
build/
.vercel/
.netlify/
.output/

# ------------------------------------------
# Vite
# ------------------------------------------
dist/
vite.config.*.timestamp-*
vite.config.ts.timestamp-*

# ------------------------------------------
# TypeScript
# ------------------------------------------
*.tsbuildinfo

# ------------------------------------------
